# Copy to .env for local development.

# Spring Boot API base URL. Empty means same-origin.
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth 2.0 Client ID (Web application) from
# https://console.cloud.google.com/apis/credentials — must match
# ENGLISHER_GOOGLE_CLIENT_ID on the server. Leave blank to hide/disable the
# "Continue with Google" button's functionality (see lib/oauth.ts).
VITE_GOOGLE_CLIENT_ID=

# Facebook App ID from https://developers.facebook.com/apps/ — must match
# ENGLISHER_FACEBOOK_APP_ID on the server. Leave blank to disable
# "Continue with Facebook".
VITE_FACEBOOK_APP_ID=
