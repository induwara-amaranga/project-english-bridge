# Caddy config baked into the frontend image (see Dockerfile) — changes to
# this file ship through the normal CI/CD pipeline, not a manual server edit.
#
# {$DOMAIN} is supplied by docker-compose.prod.yml from the server's .env.
# Caddy requests and auto-renews a Let's Encrypt certificate for it the first
# time it starts, which requires DNS for that name to already point at this
# server and ports 80/443 to be reachable from the internet.

# rate_limit is a third-party directive (see Dockerfile) with no built-in
# place in Caddy's default directive order, so it has to be told where to
# run — before the request reaches reverse_proxy.
{
	order rate_limit before reverse_proxy
}

{$DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Per-IP throttling on the auth endpoints that matter for brute force /
	# abuse: signin (password guessing), verify-otp (admin 2FA code
	# guessing — on top of AuthService's own per-account attempt lockout),
	# and signup (fake-account spam). Everything else under /api/* (reading
	# curriculum, submitting progress, etc.) is left unlimited here.
	rate_limit {
		zone auth_login {
			match {
				path /api/auth/signin /api/auth/verify-otp /api/auth/google /api/auth/facebook
			}
			key {remote_host}
			events 10
			window 1m
		}
		zone auth_signup {
			match {
				path /api/auth/signup
			}
			key {remote_host}
			events 5
			window 1h
		}
	}

	# The Spring Boot API, reached over the compose network — never exposed
	# to the host directly (see docker-compose.prod.yml).
	handle /api/* {
		reverse_proxy backend:8080
	}

	# The built React app. try_files falls back to index.html for any path
	# React Router owns client-side, instead of Caddy 404ing on a refresh of
	# a deep link like /stage/2/lesson/1.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
