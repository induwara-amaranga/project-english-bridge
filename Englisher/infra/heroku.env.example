# Copy to infra/heroku.env (gitignored) and fill in. heroku-setup.sh pushes
# every KEY=value line here to the app's config vars. One per line, no quotes,
# no spaces around "=". Change one later with:
#   heroku config:set KEY=value -a <app>
#
# Not listed on purpose: DATABASE_URL (Heroku Postgres sets and rotates it),
# PORT (Heroku assigns it), SPRING_PROFILES_ACTIVE / JAVA_TOOL_OPTIONS /
# ENGLISHER_TRUSTED_PROXY_HOPS (heroku-setup.sh sets those itself).

# --- Auth ----------------------------------------------------------------
# At least 32 bytes. Generate with: openssl rand -base64 32
ENGLISHER_JWT_SECRET=
# The one way in before any other admin exists.
ENGLISHER_ADMIN_EMAIL=
ENGLISHER_ADMIN_PASSWORD=
# Real inbox for the admin's sign-in code. Blank falls back to ADMIN_EMAIL.
ENGLISHER_ADMIN_OTP_EMAIL=

# --- Frontend origin (Cloudflare Pages custom domain) --------------------
# Must be on the same registrable domain as the API (e.g. englisher.lk with
# api.englisher.lk) or the refresh cookie is never sent. No trailing slash.
ENGLISHER_ALLOWED_ORIGINS=https://englisher.lk
ENGLISHER_APP_BASE_URL=https://englisher.lk

# --- Outbound email (admin sign-in OTPs, parent invites) ------------------
# A real SMTP relay (Brevo, Mailgun, SES, Postmark, ...).
ENGLISHER_SMTP_HOST=
ENGLISHER_SMTP_PORT=587
ENGLISHER_SMTP_USER=
ENGLISHER_SMTP_PASSWORD=
ENGLISHER_SMTP_AUTH=true
ENGLISHER_SMTP_STARTTLS=true
ENGLISHER_MAIL_FROM=no-reply@englisher.lk

# --- Social sign-in (optional; disabled with a 503 until set) -------------
ENGLISHER_GOOGLE_CLIENT_ID=
ENGLISHER_FACEBOOK_APP_ID=
ENGLISHER_FACEBOOK_APP_SECRET=
