            {
              "id": "ba-2",
              "type": "mcq",
              "prompt": {
                "en": "Which sentence uses \"because\" correctly?",
                "si": ""
              },
              "feedback": {
                "correct": {
                  "en": "Right — \"because\" needs a full clause after it.",
                  "si": ""
