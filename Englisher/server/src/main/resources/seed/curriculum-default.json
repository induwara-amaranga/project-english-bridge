            }
          ],
          "exercises": [
            {
              "id": "ba-1",
              "type": "match",
              "prompt": {
                "en": "Match each Sinhala phrase to its English joining word.",
                "si": "සිංහල වාක්‍ය ඛණ්ඩය ගැළපෙන ඉංග්‍රීසි වචනයට ගළපන්න."
              },
              "feedback": {
                "correct": {
                  "en": "All matched.",
                  "si": ""
                },
                "incorrect": {
                  "en": "Some pairs are not matched yet.",
                  "si": ""
                }
              },
              "payload": {
                "pairs": [
                  {
                    "left": "නිසා",
                    "right": "because"
                  },
                  {
                    "left": "නමුත්",
                    "right": "although"
                  },
                  {
                    "left": "නම්",
                    "right": "if"
                  }
                ]
              },
              "cards": [
                {
