                    "accept": [
                      "watch"
                    ],
                    "choices": [
                      "watch",
                      "watches",
                      "watching"
                    ]
                  },
                  "feedback": {
                    "correct": {
                      "en": "Correct! 'We' takes the base form of the verb.",
