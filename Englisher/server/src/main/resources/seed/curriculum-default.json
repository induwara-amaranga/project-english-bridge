        {
          "id": "present-simple",
          "order": 2,
          "kind": "practice",
          "title": {
            "en": "Present simple",
            "si": "වර්තමාන කාලය"
          },
          "explanation": {
            "en": "Use the base verb with I / you / we / they, and add -s for he / she / it.",
            "si": ""
          },
          "cards": [
            {
              "id": "present-simple-c1",
              "type": "text",
              "column": "full",
              "body": {
                "en": "Use the base verb with I / you / we / they, and add -s for he / she / it.",
                "si": ""
              }
            }
          ],
          "exercises": [
            {
              "id": "ps-1",
              "type": "gap_fill",
              "prompt": {
                "en": "Complete the sentence.",
                "si": "වාක්‍යය සම්පූර්ණ කරන්න."
              },
              "feedback": {
                "correct": {
                  "en": "Correct! 'We' takes the base form of the verb.",
                  "si": ""
                },
                "incorrect": {
                  "en": "Almost — with 'we', use the base verb form.",
                  "si": ""
                }
              },
              "payload": {
                "template": {
                  "en": "We ___ English every day.",
                  "si": ""
                },
                "accept": [
                  "watch"
                ],
                "choices": [
                  "watch",
                  "watches",
                  "watching"
                ]
              },
              "cards": [
                {
                  "id": "ps-1-c1",
                  "type": "gap_fill",
                  "column": "full",
                  "prompt": {
                    "en": "Complete the sentence.",
                    "si": "වාක්‍යය සම්පූර්ණ කරන්න."
