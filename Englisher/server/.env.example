# Copy to .env (already gitignored) next to docker-compose.yml and fill in
# real values. Never commit .env — this file holds placeholders only.
#
# For local dev, only the OAuth vars below are worth setting (everything
# else has a safe throwaway default under the `dev` profile — see
# application-dev.yml). For production, use docker-compose.prod.yml
# alongside this same .env and fill in every value marked (required in prod).

# --- Database ---------------------------------------------------------
# (required in prod) Matches db's POSTGRES_PASSWORD in docker-compose.prod.yml.
ENGLISHER_DB_PASSWORD=

# --- Auth ---------------------------------------------------------------
# (required in prod) At least 32 bytes. Generate with: openssl rand -base64 32
ENGLISHER_JWT_SECRET=
# (required in prod) The one way in before any other admin exists.
ENGLISHER_ADMIN_EMAIL=
ENGLISHER_ADMIN_PASSWORD=
# Where that admin's sign-in code is emailed — falls back to
# ENGLISHER_ADMIN_EMAIL itself if left blank, which only works if that's a
# real inbox (it usually isn't in prod; admin@yourdomain.com-style addresses
# are fine if they actually route somewhere you read).
ENGLISHER_ADMIN_OTP_EMAIL=
# (required in prod) Comma-separated, no trailing slash — your real frontend
# origin(s), e.g. https://englisher.lk
ENGLISHER_ALLOWED_ORIGINS=

# --- Outbound email (admin sign-in OTPs) ---------------------------------
# Dev: leave unset, points at the local Mailpit container. Prod: a real SMTP
# relay (SES, SendGrid, Mailgun, Postmark, your own Postfix, ...) — using a
# personal Gmail account's SMTP here is not recommended for production.
ENGLISHER_SMTP_HOST=
ENGLISHER_SMTP_PORT=587
ENGLISHER_SMTP_USER=
ENGLISHER_SMTP_PASSWORD=
ENGLISHER_SMTP_AUTH=true
ENGLISHER_SMTP_STARTTLS=true
ENGLISHER_MAIL_FROM=no-reply@yourdomain.com

# --- Social sign-in (optional — stays disabled with a 503 until set) -----
ENGLISHER_GOOGLE_CLIENT_ID=
ENGLISHER_FACEBOOK_APP_ID=
ENGLISHER_FACEBOOK_APP_SECRET=
