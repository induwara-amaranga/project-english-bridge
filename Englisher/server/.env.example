# Copy to .env (already gitignored) next to docker-compose.yml for local
# development. Never commit .env — this file holds placeholders only.
#
# Everything else has a safe throwaway default under the `dev` profile (see
# application-dev.yml), and mail goes to the local Mailpit container.
# Production config lives in Heroku config vars — see infra/heroku.env.example.

# Where the seeded admin's sign-in code is emailed (caught by Mailpit at
# http://localhost:8025). Blank falls back to the admin email itself.
ENGLISHER_ADMIN_OTP_EMAIL=

# --- Social sign-in (optional — stays disabled with a 503 until set) -----
ENGLISHER_GOOGLE_CLIENT_ID=
ENGLISHER_FACEBOOK_APP_ID=
ENGLISHER_FACEBOOK_APP_SECRET=
